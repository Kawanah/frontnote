---
import BoutonCopier from '../../../components/BoutonCopier.astro'
import Message from '../../../components/Message.astro'
import Champ from '../../../components/Champ.astro'
import Badge from '../../../components/Badge.astro'
import Layout from '../../../layouts/Layout.astro'
import { dateCourte, TON_STATUT } from '../../../lib/affichage'
import { actionsRapides, passerATraiter, RAISONS_REFUS } from '../../../lib/actions'
import {
  getCorrection,
  listCorrections,
  mettreAJour,
  miseAJourAgenceSchema,
} from '../../../lib/corrections'
import { DomainError } from '../../../lib/errors'
import { statutDepuisForm } from '../../../lib/formulaires'
import {
  filtreDepuisParams,
  ONGLETS,
  ongletDepuisParams,
  requeteFiltre,
} from '../../../lib/navigation'
import { getProjet } from '../../../lib/projets'
import { getDb } from '../../../lib/runtime'
import {
  APPAREIL_LABELS,
  GRAVITE_LABELS,
  LIEU_LABELS,
  NATURE_LABELS,
  STATUT_LABELS,
  STATUTS,
  type Statut,
} from '../../../lib/vocabulaire'

const db = getDb()
const projet = getProjet(db, Astro.params.projet ?? '')
if (!projet) return new Response('Projet inconnu', { status: 404 })

const retourListe = (param: string) => {
  const retour = new URLSearchParams(requeteFiltre(Astro.url.searchParams))
  const [cle, valeur] = param.split('=')
  retour.set(cle!, valeur!)
  return Astro.redirect(`/projets/${projet.id}?${retour}`)
}

let erreurListe = ''
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('_action')
  if (action === 'a_traiter') {
    // « À traiter » d'une ligne, ou de toutes les lignes cochées
    const un = form.get('un')
    const ids = un ? [String(un)] : form.getAll('selection').map(String)
    const revision = Number(form.get('revision'))
    const erreurs: string[] = []
    for (const id of ids) {
      const c = getCorrection(db, id)
      if (c?.projet !== projet.id) {
        erreurs.push(`${id} : introuvable dans ce projet`)
        continue
      }
      try {
        passerATraiter(db, c, revision, String(form.get(`attendu:${id}`) ?? ''))
      } catch (err) {
        if (!(err instanceof DomainError)) throw err
        erreurs.push(`${id} : ${err.message}`)
      }
    }
    if (!ids.length) erreurListe = 'Cochez au moins une demande.'
    else if (erreurs.length) erreurListe = erreurs.join(' · ')
    else return retourListe(`traitees=${ids.join(',')}`)
  } else if (action === 'statut') {
    // Refus depuis la ligne : mêmes règles que la fiche (révision, droits, historique)
    const id = String(form.get('id') ?? '')
    const parsed = miseAJourAgenceSchema.safeParse(statutDepuisForm(form))
    if (getCorrection(db, id)?.projet !== projet.id) {
      erreurListe = `Demande ${id} introuvable dans ce projet.`
    } else if (!parsed.success) {
      erreurListe = `${id} : ${parsed.error.issues.map((i) => i.message).join(' ; ')}`
    } else {
      try {
        mettreAJour(db, id, 'agence', parsed.data)
        return retourListe(`maj=${id}:${parsed.data.statut}`)
      } catch (err) {
        if (!(err instanceof DomainError)) throw err
        erreurListe = `${id} : ${err.message}`
      }
    }
  }
}

const params = Astro.url.searchParams
const onglet = ongletDepuisParams(params)
const filtre = filtreDepuisParams(params)
const requete = requeteFiltre(params)
// Demande que l'on vient de traiter depuis sa fiche (dernière de la liste)
const fait = params.get('fait')
const traitees = (params.get('traitees') ?? '').split(',').filter(Boolean)
// Refus appliqué depuis la ligne : « KAW-003:refusee »
const [majId, majStatut] = (params.get('maj') ?? '').split(':')
const maj =
  majId && STATUTS.includes(majStatut as Statut) ? { id: majId, statut: majStatut as Statut } : null
// Filtres retirés de l'écran mais gardés dans l'adresse (liens existants)
const autresFiltres = [
  filtre.nature && `nature « ${NATURE_LABELS[filtre.nature]} »`,
  filtre.appareil && `écran « ${APPAREIL_LABELS[filtre.appareil]} »`,
  filtre.lot && `lot « ${filtre.lot} »`,
].filter(Boolean)

const toutes = listCorrections(db, projet.id)
const compte = (statuts: readonly Statut[]) =>
  toutes.filter((c) => statuts.includes(c.statut)).length
const corrections = listCorrections(db, projet.id, filtre)
const lignes = corrections.map((c) => ({ c, actions: actionsRapides(c) }))
const cochables = lignes.filter(
  ({ actions }) => actions.aTraiter === 'bouton' || actions.aTraiter === 'attendu'
)

// Message à donner à l'agent du site : la marche à suivre est dans son CLAUDE.md
const pourAgent = `Traite les corrections FrontNote « À traiter » du projet ${projet.id}, en suivant la section « Corrections (FrontNote) » du CLAUDE.md.`
const enCours = compte(ONGLETS[1].statuts)
---

<Layout title={projet.nom} fil={[[projet.nom]]}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold tracking-tight">{projet.nom}</h1>
    <div class="flex flex-wrap items-center gap-2">
      {projet.jeton_agent ? (
        <BoutonCopier cible="#pour-agent" libelle="Copier pour l'agent" class="bouton-principal" />
      ) : (
        <a href={`/projets/${projet.id}/reglages`} class="text-sm text-accent underline">
          Jeton agent à créer
        </a>
      )}
      <a href={`/projets/${projet.id}/reglages`} class="bouton">
        Réglages
      </a>
    </div>
    <p id="pour-agent" hidden>
      {pourAgent}
    </p>
  </div>

  {projet.clos_le && (
    <p class="mb-4 rounded-md border border-line bg-paper px-4 py-2 text-sm">
      <span class="font-semibold">Projet clos le {dateCourte(projet.clos_le)}.</span> Le widget ne
      s'affiche plus.{' '}
      <a href={`/projets/${projet.id}/reglages`} class="underline">
        Rouvrir ou retirer le widget
      </a>
    </p>
  )}

  {fait && (
    <Message class="mb-4">
      <span class="font-mono">{fait}</span> est passée « À traiter ». C'était la dernière de la
      liste.
    </Message>
  )}
  {traitees.length > 0 && (
    <Message class="mb-4">
      {traitees.length > 1 ? `${traitees.length} demandes passées` : `${traitees[0]} passée`} « À
      traiter » : l'agent peut les prendre.
    </Message>
  )}
  {maj && (
    <Message class="mb-4">
      <span class="font-mono">{maj.id}</span> : {STATUT_LABELS[maj.statut]}.
    </Message>
  )}
  {erreurListe && (
    <Message ton="erreur" class="mb-4">
      {erreurListe}
    </Message>
  )}

  <nav class="mb-4 flex flex-wrap gap-1 border-b border-line" aria-label="Demandes">
    {ONGLETS.map((o) => {
      const actif = onglet === o.cle
      const n = compte(o.statuts)
      return (
        <a
          href={
            o.cle === 'qualifier'
              ? `/projets/${projet.id}`
              : `/projets/${projet.id}?statut=${o.cle}`
          }
          aria-current={actif ? 'page' : undefined}
          class:list={[
            '-mb-px border-b-2 px-3 py-2 text-sm',
            actif ? 'border-ink font-semibold' : 'border-transparent text-muted hover:text-ink',
          ]}
        >
          {o.label}
          {n > 0 && <span class="ml-1 text-xs text-muted">{n}</span>}
        </a>
      )
    })}
  </nav>

  {autresFiltres.length > 0 && (
    <p class="mb-4 text-sm text-muted">
      Filtré aussi par {autresFiltres.join(', ')} ·{' '}
      <a
        href={`/projets/${projet.id}${onglet && onglet !== 'qualifier' ? `?statut=${onglet}` : ''}`}
        class="underline"
      >
        retirer
      </a>
    </p>
  )}

  <datalist id="raisons-refus">
    {RAISONS_REFUS.map((r) => (
      <option value={r} />
    ))}
  </datalist>

  <form method="post" id="a-traiter">
    <input type="hidden" name="_action" value="a_traiter" />
    <input type="hidden" name="revision" value={projet.revision} />
  </form>

  {corrections.length === 0 ? (
    <p class="carte text-muted">
      {onglet === 'qualifier'
        ? enCours
          ? `Rien à qualifier. ${enCours} demande${enCours > 1 ? 's' : ''} en cours chez l'agent.`
          : "Rien à qualifier. Les retours du client arrivent ici dès qu'il utilise le widget."
        : 'Aucune demande ici.'}
    </p>
  ) : (
    <>
      {cochables.length > 1 && (
        <div class="mb-2 flex flex-wrap items-center gap-3 text-sm">
          <label class="flex items-center gap-2">
            <input type="checkbox" data-tout-cocher />
            Tout cocher
          </label>
          <button form="a-traiter" class="bouton-principal text-xs">
            Passer la sélection « À traiter »
          </button>
        </div>
      )}
      <div class="overflow-x-auto rounded-lg border border-line bg-surface">
        <table class="w-full text-left text-sm">
          <tbody>
            {lignes.map(({ c, actions }) => {
              const fiche = `/projets/${projet.id}/${c.id}${requete}`
              const cochable = actions.aTraiter === 'bouton' || actions.aTraiter === 'attendu'
              const defauts = [
                actions.defauts.gravite && GRAVITE_LABELS[actions.defauts.gravite],
                actions.defauts.lieu_correction && LIEU_LABELS[actions.defauts.lieu_correction],
                actions.defauts.lot,
              ].filter(Boolean)
              return (
                <tr class="border-b border-line align-top last:border-0 hover:bg-paper">
                  {cochables.length > 1 && (
                    <td class="w-8 py-3 pl-4">
                      {cochable && (
                        <input
                          type="checkbox"
                          form="a-traiter"
                          name="selection"
                          value={c.id}
                          aria-label={`Sélectionner ${c.id}`}
                        />
                      )}
                    </td>
                  )}
                  <td class="px-4 py-3 font-mono whitespace-nowrap">
                    <a href={fiche} class="font-semibold underline-offset-2 hover:underline">
                      {c.id}
                    </a>
                    <p class="mt-1 font-sans text-xs text-muted">
                      {dateCourte(c.date_signalement)}
                    </p>
                  </td>
                  <td class="w-full min-w-48 px-4 py-3">
                    <p class="line-clamp-2">
                      {c.nature === 'texte' || c.texte_attendu ? (
                        <>
                          {c.texte_actuel && (
                            <span class="text-muted line-through">{c.texte_actuel}</span>
                          )}{' '}
                          {c.texte_attendu}
                        </>
                      ) : (
                        c.constat
                      )}
                    </p>
                    <p class="mt-1 truncate text-xs text-muted">
                      <span class="font-mono">{c.page}</span> · {c.zone} ·{' '}
                      {APPAREIL_LABELS[c.appareil]}
                    </p>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    {onglet !== 'qualifier' && (
                      <Badge ton={TON_STATUT[c.statut]} label={STATUT_LABELS[c.statut]} />
                    )}
                    <p class="mt-1 text-xs text-muted">
                      {c.nature ? (
                        NATURE_LABELS[c.nature]
                      ) : (
                        <span class="text-accent">Type à préciser</span>
                      )}
                      {c.gravite && <> · {GRAVITE_LABELS[c.gravite]}</>}
                    </p>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-start justify-end gap-2">
                      {actions.aTraiter === 'attendu' && (
                        <input
                          class="champ w-44 text-xs"
                          form="a-traiter"
                          name={`attendu:${c.id}`}
                          maxlength="2000"
                          placeholder="Ce qui est attendu…"
                          aria-label={`Attendu pour ${c.id}`}
                        />
                      )}
                      {cochable && (
                        <button
                          form="a-traiter"
                          name="un"
                          value={c.id}
                          class="bouton-principal text-xs whitespace-nowrap"
                          title={defauts.length ? `Posé aussi : ${defauts.join(' · ')}` : undefined}
                        >
                          À traiter
                        </button>
                      )}
                      {actions.aTraiter === 'qualifier' && (
                        <a
                          href={fiche}
                          class="bouton text-xs whitespace-nowrap"
                          title={`Il manque : ${actions.manquants.join(', ')}`}
                        >
                          Qualifier →
                        </a>
                      )}
                      {actions.refuser && (
                        <details class="relative">
                          <summary class="bouton cursor-pointer list-none text-xs whitespace-nowrap">
                            Refuser
                          </summary>
                          <form
                            method="post"
                            class="carte absolute right-0 z-10 mt-1 w-64 space-y-2 shadow-lg"
                          >
                            <input type="hidden" name="_action" value="statut" />
                            <input type="hidden" name="id" value={c.id} />
                            <input type="hidden" name="revision" value={projet.revision} />
                            <input type="hidden" name="statut" value="refusee" />
                            <Champ etiquette="Raison du refus">
                              <input
                                class="champ"
                                name="historique_note"
                                list="raisons-refus"
                                required
                                maxlength="500"
                                placeholder="Essai de l'agence…"
                              />
                            </Champ>
                            <button class="bouton bouton-danger w-full">Refuser {c.id}</button>
                          </form>
                        </details>
                      )}
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </>
  )}
</Layout>

<script>
  // Tout cocher / tout décocher
  document
    .querySelector<HTMLInputElement>('[data-tout-cocher]')
    ?.addEventListener('change', (e) => {
      const coche = (e.currentTarget as HTMLInputElement).checked
      document
        .querySelectorAll<HTMLInputElement>('input[name="selection"]')
        .forEach((c) => (c.checked = coche))
    })
</script>
