---
import Badge from '../../../components/Badge.astro'
import NavigationFiche from '../../../components/NavigationFiche.astro'
import Layout from '../../../layouts/Layout.astro'
import { dateCourte, dateHeure, lienVoir, TON_GRAVITE, TON_STATUT } from '../../../lib/affichage'
import {
  getCorrection,
  listCorrections,
  mettreAJour,
  miseAJourAgenceSchema,
  transitionsPossibles,
} from '../../../lib/corrections'
import { DomainError } from '../../../lib/errors'
import { RAISONS_REFUS } from '../../../lib/actions'
import {
  erreurSurDetails,
  qualificationDepuisForm,
  statutDepuisForm,
} from '../../../lib/formulaires'
import { avecParam, filtreDepuisParams, requeteFiltre, voisines } from '../../../lib/navigation'
import { getProjet } from '../../../lib/projets'
import { getDb } from '../../../lib/runtime'
import {
  APPAREIL_LABELS,
  APPAREILS,
  GRAVITE_LABELS,
  GRAVITES,
  LIEU_LABELS,
  LIEUX,
  NATURE_LABELS,
  STATUT_LABELS,
} from '../../../lib/vocabulaire'

const db = getDb()
const projet = getProjet(db, Astro.params.projet ?? '')
let correction = getCorrection(db, Astro.params.id ?? '')
if (!projet || !correction || correction.projet !== projet.id) {
  return new Response('Correction introuvable', { status: 404 })
}

// Même filtre que la liste : retour, précédente et suivante suivent son ordre
const requete = requeteFiltre(Astro.url.searchParams)
const liste = `/projets/${projet.id}${requete}`
const lienFiche = (id: string, param?: string) =>
  `/projets/${projet.id}/${id}${param ? avecParam(requete, param) : requete}`
const ordre = listCorrections(db, projet.id, filtreDepuisParams(Astro.url.searchParams)).map(
  (x) => x.id
)
const { precedente, suivante } = voisines(ordre, correction.id)

let erreur = ''
let enregistre = Astro.url.searchParams.has('ok')
const traitee = Astro.url.searchParams.get('fait')

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const patch =
    form.get('_action') === 'statut' ? statutDepuisForm(form) : qualificationDepuisForm(form)
  const parsed = miseAJourAgenceSchema.safeParse(patch)
  if (!parsed.success) {
    erreur = parsed.error.issues.map((i) => `${i.path.join('.')} : ${i.message}`).join(' ; ')
  } else {
    try {
      mettreAJour(db, correction.id, 'agence', parsed.data)
      // Passée « À traiter » : on enchaîne sur la suivante de la liste, sinon retour à la liste
      if (parsed.data.statut === 'a_traiter') {
        return Astro.redirect(
          suivante
            ? lienFiche(suivante, `fait=${correction.id}`)
            : avecParam(liste, `fait=${correction.id}`)
        )
      }
      return Astro.redirect(lienFiche(correction.id, 'ok'))
    } catch (err) {
      if (!(err instanceof DomainError)) throw err
      erreur = err.message
      enregistre = false
      // « À traiter » refusé faute de champs : la qualification saisie n'est pas perdue,
      // elle est enregistrée sans changer le statut (mêmes règles via mettreAJour)
      if (parsed.data.statut === 'a_traiter' && err.message.startsWith('Pour passer')) {
        const { statut: _statut, ...sansStatut } = parsed.data
        try {
          mettreAJour(db, correction.id, 'agence', sansStatut)
          erreur = `Qualification enregistrée. ${err.message}`
        } catch (err2) {
          if (!(err2 instanceof DomainError)) throw err2
          erreur = err2.message
        }
      }
    }
  }
  correction = getCorrection(db, correction.id)!
}

const c = correction
const revision = getProjet(db, projet.id)!.revision
const passages = transitionsPossibles('agence', c.statut)
const lienPage = lienVoir(c, projet.cle_activation)
const t = c.traitement
// Un seul bouton d'enregistrement : il fait aussi passer une nouvelle demande « À traiter »
const versTraiter = c.statut === 'nouvelle' && passages.includes('a_traiter')
// Bloc replié : ouvert d'office si l'erreur porte sur un de ses champs
const detailsOuverts = erreur !== '' && erreurSurDetails(erreur)
const texteClient = c.nature === 'texte' || Boolean(c.texte_attendu)
---

<Layout title={`${c.id} · ${projet.nom}`} fil={[[projet.nom, liste], [c.id]]}>
  <div class="mb-4">
    <NavigationFiche
      liste={liste}
      precedente={precedente && lienFiche(precedente)}
      suivante={suivante && lienFiche(suivante)}
      label="Navigation"
    />
  </div>

  {traitee && (
    <p class="mb-4 rounded-md bg-ok-soft px-4 py-2 text-sm text-ok" role="status">
      <span class="font-mono">{traitee}</span> est passée « À traiter ». Voici la suivante.
    </p>
  )}

  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-mono text-2xl font-bold">{c.id}</h1>
        <Badge ton={TON_STATUT[c.statut]} label={STATUT_LABELS[c.statut]} />
        {c.gravite && <Badge ton={TON_GRAVITE[c.gravite]} label={GRAVITE_LABELS[c.gravite]} />}
      </div>
      <p class="mt-1 text-sm text-muted">
        Signalée le {dateCourte(c.date_signalement)} par {c.signale_par}
        {c.auteur && <> ({c.auteur})</>} via {c.canal} · {APPAREIL_LABELS[c.appareil]}
        {c.navigateur && <> · {c.navigateur}</>}
      </p>
    </div>
  </div>

  {enregistre && !erreur && (
    <p class="mb-4 rounded-md bg-ok-soft px-4 py-2 text-sm text-ok" role="status">
      Enregistré.
    </p>
  )}
  {erreur && (
    <p class="mb-4 rounded-md bg-danger-soft px-4 py-2 text-sm text-danger" role="alert">
      {erreur}
    </p>
  )}

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-6">
      <section class="carte space-y-4">
        <h2 class="font-bold">Retour du client</h2>
        <p class="text-sm">
          <span class="etiquette inline">Zone :</span> {c.zone}
        </p>
        {texteClient ? (
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <p class="etiquette">Texte attendu, mot pour mot (non modifiable)</p>
              <p class="rounded-md border border-ink bg-surface p-3 whitespace-pre-wrap">
                {c.texte_attendu}
              </p>
            </div>
            <div>
              <p class="etiquette">Texte actuel</p>
              <p class="rounded-md bg-paper p-3 text-sm whitespace-pre-wrap text-muted">
                {c.texte_actuel || '(vide)'}
              </p>
            </div>
          </div>
        ) : (
          c.constat && (
            <blockquote class="rounded-md border-l-4 border-ink bg-paper p-3 whitespace-pre-wrap">
              {c.constat}
            </blockquote>
          )
        )}
        <div class="flex flex-wrap items-center gap-3 rounded-md bg-paper p-3 text-sm">
          <span class="etiquette inline">Page :</span>
          <span class="min-w-0 flex-1 font-mono break-all">{c.page}</span>
          {lienPage && (
            <a href={lienPage} target="_blank" class="bouton-principal whitespace-nowrap">
              Voir sur la page ↗
            </a>
          )}
        </div>
        <dl class="grid gap-3 text-sm sm:grid-cols-2">
          {c.type_client && (
            <div>
              <dt class="etiquette">Type choisi par le client</dt>
              <dd>{c.type_client}</dd>
            </div>
          )}
          {c.couleur && (
            <div>
              <dt class="etiquette">Couleur souhaitée</dt>
              <dd class="flex items-center gap-2">
                <span
                  class="inline-block size-4 rounded border border-line"
                  style={`background:${c.couleur}`}
                ></span>
                <span class="font-mono">{c.couleur}</span>
              </dd>
            </div>
          )}
        </dl>
        {c.selecteur && (
          <p class="text-xs text-muted">
            Sélecteur : <span class="font-mono break-all">{c.selecteur}</span>
          </p>
        )}
      </section>

      <section class="carte">
        <h2 class="mb-4 font-bold">Qualification</h2>
        <form method="post" class="grid gap-4 sm:grid-cols-2">
          <input type="hidden" name="revision" value={revision} />
          <label>
            <span class="etiquette">Nature</span>
            <select class="champ" name="nature">
              <option value="">À qualifier</option>
              {projet.natures.map((n) => (
                <option value={n} selected={c.nature === n}>
                  {NATURE_LABELS[n]}
                </option>
              ))}
            </select>
          </label>
          <label>
            <span class="etiquette">Gravité</span>
            <select class="champ" name="gravite">
              <option value="">·</option>
              {GRAVITES.map((g) => (
                <option value={g} selected={c.gravite === g}>
                  {GRAVITE_LABELS[g]}
                </option>
              ))}
            </select>
          </label>
          <label class="sm:col-span-2">
            <span class="etiquette">Constat</span>
            <textarea class="champ" name="constat" rows="2">{c.constat ?? ''}</textarea>
          </label>
          <label class="sm:col-span-2">
            <span class="etiquette">Attendu</span>
            <textarea class="champ" name="attendu" rows="2">{c.attendu ?? ''}</textarea>
          </label>
          <label class="sm:col-span-2">
            <span class="etiquette">Note de l'agence</span>
            <textarea class="champ" name="note" rows="2">{c.note ?? ''}</textarea>
          </label>

          <details class="rounded-md border border-line p-3 sm:col-span-2" open={detailsOuverts}>
            <summary class="cursor-pointer text-sm font-semibold">Détails pour l'agent</summary>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label>
                <span class="etiquette">Lieu de correction</span>
                <select class="champ" name="lieu_correction">
                  <option value="">·</option>
                  {LIEUX.map((l) => (
                    <option value={l} selected={c.lieu_correction === l}>
                      {LIEU_LABELS[l]}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <span class="etiquette">Lot</span>
                <input
                  class="champ"
                  name="lot"
                  value={c.lot ?? ''}
                  placeholder="recette-2026-09-26"
                />
              </label>
              <label>
                <span class="etiquette">Page</span>
                <input class="champ font-mono" name="page" value={c.page} />
              </label>
              <label>
                <span class="etiquette">Appareil</span>
                <select class="champ" name="appareil">
                  {APPAREILS.map((a) => (
                    <option value={a} selected={c.appareil === a}>
                      {APPAREIL_LABELS[a]}
                    </option>
                  ))}
                </select>
              </label>
              <label class="sm:col-span-2">
                <span class="etiquette">Zone</span>
                <input class="champ" name="zone" value={c.zone} />
              </label>
              <label class="sm:col-span-2">
                <span class="etiquette">État (appli : connecté, rôle, données)</span>
                <input class="champ" name="etat" value={c.etat ?? ''} />
              </label>
              <label>
                <span class="etiquette">Source du texte (lien Google Doc)</span>
                <input
                  class="champ"
                  type="url"
                  name="source_lien"
                  value={c.source_texte?.lien ?? ''}
                />
              </label>
              <label>
                <span class="etiquette">Lu le</span>
                <input
                  class="champ"
                  type="date"
                  name="source_lu_le"
                  value={c.source_texte?.lu_le ?? ''}
                />
              </label>
              <label class="sm:col-span-2">
                <span class="etiquette">Pièces jointes (un lien par ligne)</span>
                <textarea
                  class="champ font-mono text-xs"
                  name="pieces_jointes"
                  rows="2"
                >{c.pieces_jointes.join('\n')}</textarea>
              </label>
              <label>
                <span class="etiquette">Test lié</span>
                <input
                  class="champ font-mono"
                  name="test_lie"
                  value={c.test_lie ?? ''}
                  placeholder="LEG-04"
                />
              </label>
              <label>
                <span class="etiquette">Ligne de suivi</span>
                <input
                  class="champ"
                  type="number"
                  min="1"
                  name="ligne_suivi"
                  value={c.ligne_suivi ?? ''}
                />
              </label>
            </div>
          </details>

          <div class="sm:col-span-2">
            {versTraiter ? (
              <button class="bouton-principal" name="statut" value="a_traiter">
                Enregistrer et passer à traiter
              </button>
            ) : (
              <button class="bouton-principal">Enregistrer</button>
            )}
          </div>
        </form>
      </section>
    </div>

    <aside class="space-y-6">
      {passages.length > 0 && (
        <section class="carte">
          <h2 class="mb-3 font-bold">Changer le statut</h2>
          <form method="post" class="space-y-3">
            <input type="hidden" name="_action" value="statut" />
            <input type="hidden" name="revision" value={revision} />
            <select class="champ" name="statut" required>
              {passages.map((s) => (
                <option value={s}>{STATUT_LABELS[s]}</option>
              ))}
            </select>
            <textarea
              class="champ"
              name="historique_note"
              rows="2"
              placeholder="Note (raison d'un refus, d'un doublon…)"
            ></textarea>
            <button class="bouton w-full">Appliquer</button>
          </form>
          {passages.includes('refusee') && (
            <form method="post" class="mt-4 space-y-2 border-t border-line pt-4">
              <input type="hidden" name="_action" value="statut" />
              <input type="hidden" name="revision" value={revision} />
              <input type="hidden" name="statut" value="refusee" />
              <label class="block">
                <span class="etiquette">Raccourci : refuser (raison)</span>
                <input
                  class="champ"
                  name="historique_note"
                  list="raisons-refus"
                  required
                  maxlength="500"
                  placeholder="Essai de l'agence…"
                />
              </label>
              <datalist id="raisons-refus">
                {RAISONS_REFUS.map((r) => (
                  <option value={r} />
                ))}
              </datalist>
              <button class="bouton w-full border-danger text-danger">Refuser</button>
            </form>
          )}
        </section>
      )}

      <section class="carte space-y-3 text-sm">
        <h2 class="font-bold">Retour de l'agent</h2>
        {t || c.question || c.signalement ? (
          <dl class="space-y-3">
            {c.question && (
              <div>
                <dt class="etiquette">Question pour le client</dt>
                <dd class="rounded-md bg-warn-soft p-2">{c.question}</dd>
              </div>
            )}
            {t?.resume && (
              <div>
                <dt class="etiquette">Résumé</dt>
                <dd>{t.resume}</dd>
              </div>
            )}
            {t?.verification && (
              <div>
                <dt class="etiquette">Vérification</dt>
                <dd>{t.verification}</dd>
              </div>
            )}
            {t?.branche && (
              <div>
                <dt class="etiquette">Branche</dt>
                <dd class="font-mono break-all">{t.branche}</dd>
              </div>
            )}
            {t?.pr && (
              <div>
                <dt class="etiquette">PR</dt>
                <dd class="font-mono">#{t.pr}</dd>
              </div>
            )}
            {t?.commits?.length ? (
              <div>
                <dt class="etiquette">Commits</dt>
                <dd class="font-mono">{t.commits.join(', ')}</dd>
              </div>
            ) : null}
            {t?.date && (
              <div>
                <dt class="etiquette">Corrigée le</dt>
                <dd>{dateCourte(t.date)}</dd>
              </div>
            )}
            {c.signalement && (
              <div>
                <dt class="etiquette">Signalement (texte du client)</dt>
                <dd>{c.signalement}</dd>
              </div>
            )}
          </dl>
        ) : (
          <p class="text-muted">Rien pour l'instant.</p>
        )}
      </section>

      <section class="carte text-sm">
        <h2 class="mb-3 font-bold">Historique</h2>
        <ol class="space-y-3 border-l border-line pl-4">
          {c.historique.map((h) => (
            <li>
              <p>
                <span class="font-semibold">
                  {h.de ? `${STATUT_LABELS[h.de]} → ` : ''}
                  {STATUT_LABELS[h.vers]}
                </span>
                <span class="text-muted"> · {h.auteur}</span>
              </p>
              <p class="text-xs text-muted">{dateHeure(h.date)}</p>
              {h.note && <p class="mt-1">{h.note}</p>}
            </li>
          ))}
        </ol>
      </section>

      {c.contexte && (
        <details class="carte text-sm">
          <summary class="cursor-pointer font-bold">Contexte technique</summary>
          <dl class="mt-3 space-y-2">
            <div>
              <dt class="etiquette">Fenêtre</dt>
              <dd>
                {c.contexte.viewport.width} × {c.contexte.viewport.height} px
              </dd>
            </div>
            <div>
              <dt class="etiquette">Écran</dt>
              <dd>
                {c.contexte.screen.width} × {c.contexte.screen.height} px, densité{' '}
                {c.contexte.pixelRatio}
              </dd>
            </div>
            <div>
              <dt class="etiquette">Tactile</dt>
              <dd>{c.contexte.touch ? 'oui' : 'non'}</dd>
            </div>
            {c.contexte.language && (
              <div>
                <dt class="etiquette">Langue</dt>
                <dd>{c.contexte.language}</dd>
              </div>
            )}
            <div>
              <dt class="etiquette">Navigateur (brut)</dt>
              <dd class="font-mono text-xs break-all">{c.contexte.userAgent}</dd>
            </div>
          </dl>
        </details>
      )}
    </aside>
  </div>

  <div class="mt-8 border-t border-line pt-6">
    <NavigationFiche
      liste={liste}
      precedente={precedente && lienFiche(precedente)}
      suivante={suivante && lienFiche(suivante)}
      label="Navigation (bas de page)"
    />
  </div>
</Layout>
