---
import '../styles/global.css'

interface Props {
  title: string
  // Fil d'Ariane : [libellé, lien?]
  fil?: [string, string?][]
}

const { title, fil = [] } = Astro.props
const connecte = Astro.url.pathname !== '/connexion'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · FrontNote</title>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <nav class="flex min-w-0 items-center gap-2 text-sm" aria-label="Fil d'Ariane">
          <a href="/" class="font-bold tracking-tight">
            FrontNote
          </a>
          {fil.map(([label, href]) => (
            <>
              <span class="text-muted">/</span>
              {href ? (
                <a href={href} class="truncate hover:underline">
                  {label}
                </a>
              ) : (
                <span class="truncate text-muted">{label}</span>
              )}
            </>
          ))}
        </nav>
        {connecte && (
          <form method="post" action="/deconnexion">
            <button class="text-sm text-muted hover:text-ink">Déconnexion</button>
          </form>
        )}
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
